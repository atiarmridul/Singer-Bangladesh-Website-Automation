{
  "id": "SANITY_015",
  "title": "Category - should load live category listing shell",
  "tags": ["@ai", "@catalog", "@sanity", "@category"],
  "purpose": "validates that a live category with products reaches a hydrated listing surface.",
  "risk": "category page shell loads but listing content never becomes available for current catalog data.",
  "steps": [
    {
      "action": "goto",
      "path": "/category/television?category=television&page=1&limit=12"
    },
    {
      "action": "expectUrl",
      "pattern": "/category/television"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product cards or product links",
        "css": ".product-card, a[href*='/product/']",
        "candidates": [".product-card", "a[href*='/product/']", "main a[href*='/product/']"]
      }
    }
  ]
}
