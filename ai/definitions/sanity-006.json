{
  "id": "SANITY_006",
  "title": "Cart - should add live in-stock product to cart",
  "tags": ["@ai", "@catalog", "@sanity", "@cart"],
  "purpose": "covers the main guest shopping path using a live in-stock product from API-backed test data.",
  "risk": "stale hardcoded products, disabled add-to-cart action, cart counter failure, or cart item not persisting.",
  "steps": [
    {
      "action": "goto",
      "path": "/category/television?category=television&page=1&limit=12"
    },
    {
      "action": "expectUrl",
      "pattern": "/category/television"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product cards or product links",
        "css": ".product-card, a[href*='/product/']",
        "candidates": [".product-card", "a[href*='/product/']", "main a[href*='/product/']"]
      }
    },
    {
      "action": "click",
      "selector": {
        "description": "First product details link",
        "css": ".product-card a[href*='/product/'], a[aria-label='Go to product details'][href^='/product/'], a[href*='/product/']",
        "candidates": [
          ".product-card a[href*='/product/']",
          "a[aria-label='Go to product details'][href^='/product/']",
          "a[href*='/product/']"
        ]
      }
    },
    {
      "action": "expectUrl",
      "pattern": "/product/"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product details title",
        "css": "main h1:visible",
        "candidates": ["main h1", "h1:visible"]
      }
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Add to cart button",
        "role": "button",
        "name": "Add to Cart",
        "candidates": ["button:has-text('Add to Cart')", "button:has-text('Buy Now')"]
      }
    },
    {
      "action": "click",
      "selector": {
        "description": "Add to cart button",
        "role": "button",
        "name": "Add to Cart",
        "candidates": ["button:has-text('Add to Cart')", "button:has-text('Buy Now')"]
      }
    },
    {
      "action": "goto",
      "path": "/cart"
    },
    {
      "action": "expectUrl",
      "pattern": "/cart"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Cart page surface",
        "css": ".cart.item, .cart.table-wrapper tbody tr, .cart-container .item-info, [class*='cart'], main, body",
        "candidates": [
          ".cart.item",
          ".cart.table-wrapper tbody tr",
          ".cart-container .item-info",
          "[class*='cart']",
          "main",
          "body"
        ]
      }
    }
  ]
}
