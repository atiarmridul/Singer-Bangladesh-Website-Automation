{
  "id": "REG_015",
  "title": "Product - should display price",
  "tags": ["@ai", "@catalog"],
  "purpose": "validates that price is visible in the shopper-facing PDP content.",
  "risk": "missing price, pricing component failure, or currency selector drift.",
  "steps": [
    {
      "action": "goto",
      "path": "/category/television?category=television&page=1&limit=12"
    },
    {
      "action": "expectUrl",
      "pattern": "/category/television"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product cards or product links",
        "css": ".product-card, a[href*='/product/']",
        "candidates": [".product-card", "a[href*='/product/']", "main a[href*='/product/']"]
      }
    },
    {
      "action": "click",
      "selector": {
        "description": "First product details link",
        "css": ".product-card a[href*='/product/'], a[aria-label='Go to product details'][href^='/product/'], a[href*='/product/']",
        "candidates": [
          ".product-card a[href*='/product/']",
          "a[aria-label='Go to product details'][href^='/product/']",
          "a[href*='/product/']"
        ]
      }
    },
    {
      "action": "expectUrl",
      "pattern": "/product/"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product details title",
        "css": "main h1:visible",
        "candidates": ["main h1", "h1:visible"]
      }
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product price",
        "css": "main",
        "text": "৳",
        "candidates": ["main:has-text('৳')", "main [class*='price']", "main"]
      }
    }
  ]
}
