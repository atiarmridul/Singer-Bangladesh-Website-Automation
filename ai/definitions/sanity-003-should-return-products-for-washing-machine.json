{
  "id": "SANITY_003_SHOULD_RETURN_PRODUCTS_FOR_WASHING_MACHINE",
  "title": "Search - should return products for 'washing machine'",
  "tags": ["@ai", "@catalog", "@sanity", "@search"],
  "purpose": "run the same search journey against representative high-traffic product keywords.",
  "risk": "search form submission, search routing, and empty result listing regressions.",
  "steps": [
    {
      "action": "goto",
      "path": "/category/washing-machine?category=washing-machine&page=1&limit=12"
    },
    {
      "action": "expectUrl",
      "pattern": "washing-machine"
    },
    {
      "action": "expectVisible",
      "selector": {
        "description": "Product cards or product links",
        "css": ".product-card, a[href*='/product/']",
        "candidates": [".product-card", "a[href*='/product/']", "main a[href*='/product/']"]
      }
    }
  ]
}
